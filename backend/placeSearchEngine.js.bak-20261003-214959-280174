function tdxCityFromAdministrativeText(value) {
  const text =
    String(value || "")
      .replace(/\s+/g, " ")
      .trim()
      .toLowerCase();

  if (!text) {
    return null;
  }

  for (
    const [tdxCity, aliases]
    of TDX_CITY_RULES
  ) {
    if (
      aliases.some(
        (alias) =>
          text.includes(
            alias.toLowerCase()
          )
      )
    ) {
      return tdxCity;
    }
  }

  return null;
}


const reverseGeocodeCache =
  new Map();


export async function reverseGeocodeCoordinate({
  lat,
  lon,
  apiKey = "",
}) {

  const latitude =
    Number(lat);

  const longitude =
    Number(lon);


  if (
    !validTaiwanCoordinate(
      latitude,
      longitude
    )
  ) {
    return null;
  }


  if (!apiKey) {
    return null;
  }


  /*
   * ~11 meter cache cells.
   * Good enough for administrative-area
   * classification while avoiding duplicate
   * TomTom calls from similar route geometry.
   */
  const cacheKey =
    `${latitude.toFixed(4)},${longitude.toFixed(4)}`;


  if (
    reverseGeocodeCache.has(
      cacheKey
    )
  ) {
    return reverseGeocodeCache.get(
      cacheKey
    );
  }


  const params =
    new URLSearchParams({
      key: apiKey,
      language: "zh-TW",
    });


  const url =
    "https://api.tomtom.com/search/2/reverseGeocode/" +
    `${latitude},${longitude}.json?` +
    params.toString();


  const response =
    await fetchWithTimeout(
      url,
      {
        headers: {
          Accept:
            "application/json",
        },
      },
      8000
    );


  if (!response.ok) {
    const text =
      await response.text();

    throw new Error(
      `TomTom reverse geocode HTTP ${response.status}: ` +
      text.slice(0, 160)
    );
  }


  const data =
    await response.json();


  const addresses =
    Array.isArray(
      data?.addresses
    )
      ? data.addresses
      : [];


  const address =
    addresses?.[0]?.address ||
    null;


  if (!address) {
    reverseGeocodeCache.set(
      cacheKey,
      null
    );

    return null;
  }


  /*
   * Do NOT infer city from coordinates
   * ourselves.
   *
   * The coordinates are reverse-geocoded
   * against the real map provider first.
   */
  const administrativeText =
    [
      address
        ?.countrySubdivision,

      address
        ?.countrySubdivisionName,

      address
        ?.municipality,

      address
        ?.countrySecondarySubdivision,

      address
        ?.municipalitySubdivision,

      address
        ?.freeformAddress,
    ]
      .filter(Boolean)
      .join(" ");


  const tdxCity =
    tdxCityFromAdministrativeText(
      administrativeText
    );


  const result = {
    lat:
      latitude,

    lon:
      longitude,

    tdxCity,

    municipality:
      clean(
        address
          ?.municipality
      ) || null,

    subdivision:
      clean(
        address
          ?.countrySubdivision
      ) || null,

    district:
      clean(
        address
          ?.municipalitySubdivision ||
        address
          ?.countrySecondarySubdivision
      ) || null,

    address:
      clean(
        address
          ?.freeformAddress
      ) || null,

    source:
      "TomTom Reverse Geocoding",
  };


  reverseGeocodeCache.set(
    cacheKey,
    result
  );


  return result;
}


export async function resolvePlaceUniversal({
  query,
  groqApiKey = "",
  tomtomApiKey = "",
  nearLat = null,
  nearLon = null,
}) {
  const rawQuery =
    clean(query);

  if (!rawQuery) {
    const error =
      new Error("請輸入地點");

    error.status = 400;
    throw error;
  }

  /*
   * 直接輸入經緯度時，
   * 不需要做文字搜尋。
   */
  const direct =
    directCoordinate(
      rawQuery
    );

  if (direct) {
    const result = {
      ...direct,

      displayName:
        rawQuery,

      address:
        null,

      placeId:
        `coordinate:${direct.lat},${direct.lon}`,

      locationType:
        "coordinate",

      rawTypes: [
        "coordinate",
      ],

      source:
        "Direct coordinate",

      coordinatesGrounded:
        true,
    };

    return {
      input:
        rawQuery,

      normalized: {
        normalizedQuery:
          rawQuery,

        aliases: [],

        cityHint: "",

        placeType:
          "coordinate",

        confidence: 1,

        reason:
          "Direct coordinate",
      },

      result,

      candidates: [
        result,
      ],

      source:
        result.source,

      validation: {
        accepted: true,

        coordinatesGrounded:
          true,

        aiGeneratedCoordinates:
          false,

        taiwanOnly:
          true,

        locationBiasUsed:
          false,
      },
    };
  }

  /*
   * 每次都做文字理解。
   *
   * Groq 只能：
   * - 修正錯字
   * - 正規化名稱
   * - 提供 aliases
   * - 判斷城市 / 類型
   *
   * AI 絕對不產生座標。
   */
  const normalized =
    await normalizeWithGroq(
      rawQuery,
      groqApiKey
    );

  /*
   * 城市不只依賴 AI。
   * 使用者原始輸入本身如果包含
   * 台中、台南、高雄等，就直接辨識。
   */
  const cityHint =
    inferCityHint(
      rawQuery,
      normalized.cityHint,
      normalized.normalizedQuery
    );

  const detectedPlaceType =
    normalized.placeType &&
    normalized.placeType !==
      "unknown"
      ? normalized.placeType
      : placeTypeFromText(
          rawQuery
        );

  /*
   * 搜尋多種文字版本。
   *
   * 例如：
   * 台中車佔
   * ↓
   * 台中車站
   * Taichung 台中車站
   */
  const queries =
    unique([
      rawQuery,

      normalized
        .normalizedQuery,

      ...(normalized.aliases ||
        []),

      cityHint
        ? `${cityHint} ${
            normalized
              .normalizedQuery ||
            rawQuery
          }`
        : "",

      cityHint
        ? `${cityHint} ${rawQuery}`
        : "",
    ]);

  console.log(
    "[place search]",
    {
      rawQuery,

      normalizedQuery:
        normalized
          .normalizedQuery,

      aliases:
        normalized.aliases,

      cityHint,

      placeType:
        detectedPlaceType,

      queries,
    }
  );

  /*
   * TomTom + Photon 都搜，
   * 不再因為第一個 provider
   * 有結果就直接相信。
   */
  const search =
    await searchQueries({
      queries,
      tomtomApiKey,
      nearLat,
      nearLon,
    });

  if (
    !search.candidates.length
  ) {
    const error =
      new Error(
        `無法解析地點：${rawQuery}。`
      );

    error.status = 404;
    throw error;
  }

  /*
   * 對所有候選重新評分。
   */
  const rankedCandidates =
    search.candidates
      .map(
        (candidate) => ({
          candidate,

          score:
            scoreCandidate(
              candidate,
              {
                rawQuery,

                normalizedQuery:
                  normalized
                    .normalizedQuery,

                cityHint,

                placeType:
                  detectedPlaceType,
              }
            ),
        })
      )

      /*
       * -10000 表示明確城市衝突。
       *
       * 例如：
       * 台中車站
       * vs
       * Taipei Main Station
       */
      .filter(
        (item) =>
          item.score >
          -10000
      )

      .sort(
        (a, b) =>
          b.score -
          a.score
      );

  /*
   * 如果所有候選都跟明確城市衝突，
   * 不可以偷偷拿錯城市導航。
   */
  if (
    !rankedCandidates.length
  ) {
    const error =
      new Error(
        `搜尋結果與輸入地點不一致：${rawQuery}`
      );

    error.status = 404;
    throw error;
  }

  const best =
    rankedCandidates[0];

  const result = {
    ...best.candidate,

    matchScore:
      best.score,
  };

  const candidates =
    rankedCandidates
      .slice(0, 5)
      .map(
        (item) => ({
          ...item.candidate,

          matchScore:
            item.score,
        })
      );

  const resolvedCity =
    inferCityHint(
      result.city,
      result.address,
      result.displayName
    );

  return {
    input:
      rawQuery,

    normalized: {
      ...normalized,

      cityHint,

      placeType:
        detectedPlaceType,
    },

    result,

    candidates,

    source:
      result.source,

    validation: {
      accepted: true,

      coordinatesGrounded:
        Boolean(
          result
            .coordinatesGrounded
        ),

      aiGeneratedCoordinates:
        false,

      taiwanOnly:
        validTaiwanCoordinate(
          result.lat,
          result.lon
        ),

      locationBiasUsed:
        validTaiwanCoordinate(
          Number(
            nearLat
          ),
          Number(
            nearLon
          )
        ),

      cityHint,

      resolvedCity,

      matchScore:
        best.score,
    },
  };
}
