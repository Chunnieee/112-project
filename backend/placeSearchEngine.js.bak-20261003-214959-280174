function validTaiwanCoordinate(lat, lon) {
  return (
    Number.isFinite(Number(lat)) &&
    Number.isFinite(Number(lon)) &&
    Number(lat) >= 21 &&
    Number(lat) <= 27 &&
    Number(lon) >= 118 &&
    Number(lon) <= 124
  );
}

function clean(value) {
  return String(value || "")
    .replace(/\s+/g, " ")
    .trim();
