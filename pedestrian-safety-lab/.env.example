# 複製這個檔案為 .env,填入你自己的金鑰,不要把 .env commit 進 git

# --- 必要:TDX 運輸資料流通服務平台 ---
# 免費申請: https://tdx.transportdata.tw/user/dataservice/apply
# 申請後在「會員基本資料」→「金鑰管理」建立一組 Client ID / Secret
# 沒填這兩個變數時,所有依賴 TDX 的功能(地名解析、即時路況、站點查詢、
# 高鐵/台鐵/捷運班表)都會失敗,並在後端 console 印出
# "Missing TDX_CLIENT_ID or TDX_CLIENT_SECRET in .env"
TDX_CLIENT_ID=your_tdx_client_id_here
TDX_CLIENT_SECRET=your_tdx_client_secret_here

# --- 選用:AI 地名正規化(把「我家」「台北車站附近」這類口語地址轉成正式地名) ---
# 沒有 Groq 帳號也可以先留空,系統會直接用 TDX/TGOS 原始比對結果
# 申請: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- 選用:地理編碼備援(TDX 找不到地點時的 fallback) ---
# 申請: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# --- 選用:路線規劃引擎,不設定就用官方公開示範伺服器(有速率限制,僅供測試) ---
# 自架 OSRM 範例: http://localhost:5000
OSRM_BASE_URL=https://router.project-osrm.org

# --- 選用:伺服器埠號,預設 3000 ---
PORT=3002

# --- 選用:風險統計相關,通常不用改 ---
# TDX_LIVE_MAX_AGE_MIN=20
# RISK_MIN_UNIQUE_DAYS=8
# RISK_OBSERVATION_FILE=./data/route-risk-observations.jsonl

# --- 選用:資料來源(db.js) ---
# auto(預設):有 database/pedestrian_safety.db 就用資料庫,沒有就自動改用 pedestrianSafety/data/ 的 JSON 檔
# sqlite:強制用資料庫(找不到就報錯) / json:強制用 JSON 檔
# DATA_SOURCE=auto
